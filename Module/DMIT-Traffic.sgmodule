#!name=DMIT VPS 流量监控
#!desc=登录 dmit.io 自动抓取 Cookie，面板直读 DMIT 真实账单流量

[MITM]
hostname = %APPEND% dmit.io, *.dmit.io

[Script]
dmit-capture = type=http-response,pattern=^https?://(.*\.)?dmit\.io/,script-path=https://raw.githubusercontent.com/Masamisuki/Tool/refs/heads/main/Script/DMIT-Capture.js?v=4,full-header-mode=true
dmit-traffic = type=generic,script-path=https://raw.githubusercontent.com/Masamisuki/Tool/refs/heads/main/Script/DMIT-Traffic.js?v=5,timeout=18

[Panel]
DMITTraffic = title="DMIT VPS 流量",content="点击刷新查询流量",style=info,script-name=dmit-traffic,update-interval=600
