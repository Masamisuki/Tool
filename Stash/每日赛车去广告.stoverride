name: |-
  每日赛车去广告
desc: |-
  移除开屏广告、信息流广告。
author: |-
  可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MeiRiSaiChe.png
openUrl: |-
  https://apps.apple.com/app/id1590997618
category: |-
  去广告
loon_version: |-
  3.4.0(962)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-07-02 20:41:31

http:

  mitm:
    - "api.romielf.com"

  body-rewrite:
    - >-
      ^https:\/\/api\.romielf\.com\/index\/indexv\d\? response-jq if (getpath(["data"]) | has("advertisement")) then (setpath(["data","advertisement"]; [])) else . end
    - >-
      ^https:\/\/api\.romielf\.com\/index\/indexv\d\? response-jq if (getpath(["data"]) | has("listadvertising")) then (setpath(["data","listadvertising"]; [])) else . end
    - >-
      ^https:\/\/api\.romielf\.com\/index\/indexv\d\? response-jq .data.list |= map(select(.type == 1))

