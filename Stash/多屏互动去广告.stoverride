name: |-
  多屏互动去广告
desc: |-
  移除开屏广告、横幅推广、搜索填充词，移除广告下发。
author: |-
  可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TCLnScreen.png
openUrl: |-
  https://apps.apple.com/app/id1127750481
category: |-
  去广告
loon_version: |-
  3.5.0(969)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-07-31 23:26:04

http:

  mitm:
    - "tcast-o.api.leiniao.com"

  url-rewrite:
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/ads\/ - reject-dict
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\/banner$ - reject-dict
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/searchrank$ - reject-dict
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\? - reject-dict
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/message\/v\d\/activity\? - reject-dict

  body-rewrite:
    - >-
      ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/config\/function\? response-jq .data |= map(select(.module == "tools"))

