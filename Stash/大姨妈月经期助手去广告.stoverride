http:

  mitm:
    - "forumapi.yoloho.com"
    - "dataapi.yoloho.com"
    - "shop18476221.m.youzan.com"

  url-rewrite:
    - >-
      ^https:\/\/forumapi\.yoloho\.com\/topic\/relate\/recommend\/flow\/getList\? - reject-dict
    - >-
      ^https:\/\/shop18476221\.m\.youzan\.com\/wscshop\/showcase\/feature\? - reject

  body-rewrite:
    - >-
      ^https:\/\/forumapi\.yoloho\.com\/index\/recommend\/listV\d\? response-jq .recommendList |= map(select(.voType == 0))
    - >-
      ^https:\/\/dataapi\.yoloho\.com\/tool\/bubble\/event\/new\/iconList\? response-jq .data |= map(select(.id == 21 or .id == 23 or .id == 24 or .id == 40))
    - >-
      ^https:\/\/dataapi\.yoloho\.com\/tool\/card\/mine\/app\? response-jq .data |= map(select(.type == "1"))

