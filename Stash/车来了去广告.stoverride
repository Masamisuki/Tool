name: |-
  车来了去广告
desc: |-
  清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
author: |-
  可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
openUrl: |-
  https://apps.apple.com/app/id667831823
category: |-
  去广告
loon_version: |-
  3.4.0(962)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-07-04 19:58:28

rules:
  - DOMAIN,ad.chelaile.net.cn,REJECT

http:

  mitm:
    - "api.chelaile.net.cn"
    - "web.chelaile.net.cn"
    - "cdn.web.chelaile.net.cn"
    - "image3.chelaile.net.cn"

  url-rewrite:
    - >-
      ^https:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html\? - reject
    - >-
      ^https:\/\/image3\.chelaile\.net\.cn\/hw6u6LYY\.png$ - reject-img

  script:
    - match: ^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/home\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%22jsonr%22%3A%7B%22status%22%3A%2200%22%2C%22data%22%3A%7B%22advertList%22%3A%5B%7B%22id%22%3A106%2C%22title%22%3A%22%E7%AB%99%E7%82%B9%E5%9C%B0%E5%9B%BE%22%2C%22iconUrl%22%3A%22https%3A%2F%2Fimage3.chelaile.net.cn%2F89iIqxaM.png%22%2C%22linkUrl%22%3A%22%22%2C%22adType%22%3A5%2C%22showRedDot%22%3A0%2C%22updateTime%22%3A0%2C%22appId%22%3A%22%22%2C%22appPath%22%3A%22%22%2C%22bubbleOrder%22%3A0%2C%22h5Type%22%3A0%7D%2C%7B%22id%22%3A1%2C%22title%22%3A%22%E5%9C%B0%E9%93%81%22%2C%22iconUrl%22%3A%22https%3A%2F%2Fimage3.chelaile.net.cn%2FrewrLCWY.png%22%2C%22linkUrl%22%3A%22https%3A%2F%2Fweb.chelaile.net.cn%2Fmetro%2Findex.html%3Fh5_stats_referer%3Dicon%22%2C%22adType%22%3A2%2C%22showRedDot%22%3A0%2C%22updateTime%22%3A0%2C%22appId%22%3A%22%22%2C%22appPath%22%3A%22%22%2C%22bubbleOrder%22%3A0%2C%22h5Type%22%3A0%7D%5D%7D%7D%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/listByPos\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow\/getInfo\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/api\.chelaile\.net\.cn\/led-weather\/v\d\/condition_brief\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/api\.chelaile\.net\.cn\/goocity\/config\/notices\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/api\.chelaile\.net\.cn\/encourage\/activity\/control\?
      name: "echoResponse_14"
      type: request
      timeout: 60
      argument: |-
        text=**YGKJ%7B%7DYGKJ%23%23&status-code=200

    - match: ^https:\/\/api\.chelaile\.net\.cn\/bus-side\/appToggle\/getStatus\?
      name: "清洗配置_23"
      type: response
      require-body: true

script-providers:
  "echoResponse_14":
    url: https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/echo-response.js
    interval: 86400
  "清洗配置_23":
    url: https://kelee.one/Resource/JavaScript/Chelaile/Chelaile_remove_ads.js
    interval: 86400

