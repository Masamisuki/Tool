name: |-
  摩托范去广告
desc: |-
  移除开屏广告、弹窗广告、横幅广告、文末广告及相关文章推荐、广告下发，移除我的页面商品推荐，精简搜索页面。
author: |-
  可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MotorFans.png
openUrl: |-
  https://apps.apple.com/app/id1234889389
category: |-
  去广告
loon_version: |-
  3.4.0(962)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-08-23 11:48:06

http:

  mitm:
    - "api.58moto.com"

  url-rewrite:
    - >-
      ^https:\/\/api\.58moto\.com\/advert\/ - reject-dict
    - >-
      ^https:\/\/api\.58moto\.com\/mall\/goods\/self\/list\? - reject-dict
    - >-
      ^https:\/\/api\.58moto\.com\/mall\/goods\/self\/homeList\? - reject-dict
    - >-
      ^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do$ - reject-dict

  body-rewrite:
    - >-
      ^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22004 response-jq delpaths([["data","link"]])

  script:
    - match: ^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22025
      name: "echoResponse_16"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A0%2C%22msg%22%3A%22success%22%7D&status-code=200

    - match: ^https:\/\/api\.58moto\.com\/forum\/public\/businessEssayController\.do\?action=22038
      name: "echoResponse_16"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A0%2C%22msg%22%3A%22success%22%7D&status-code=200

    - match: ^https:\/\/api\.58moto\.com\/forum\/public\/labelController\.do\?action=20112
      name: "echoResponse_16"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A0%2C%22msg%22%3A%22success%22%7D&status-code=200

    - match: ^https:\/\/api\.58moto\.com\/expands\/config\/appWholeConfig\?key=app_whole_config$
      name: "修改配置_21"
      type: response
      require-body: true

script-providers:
  "echoResponse_16":
    url: https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/echo-response.js
    interval: 86400
  "修改配置_21":
    url: https://kelee.one/Resource/JavaScript/MotorFans/MotorFans_remove_ads.js
    interval: 86400

