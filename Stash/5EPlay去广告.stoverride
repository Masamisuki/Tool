name: |-
  5EPlay去广告
desc: |-
  移除开屏广告、弹窗广告、活动角标、商城。
author: |-
  可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
openUrl: |-
  https://apps.apple.com/app/id1149334962
category: |-
  去广告
loon_version: |-
  3.4.0(962)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-08-24 18:59:19

http:

  mitm:
    - "app.5eplay.com"
    - "ya-api-app.5eplay.com"

  url-rewrite:
    - >-
      ^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ - reject-dict

  body-rewrite:
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","startup_ad_switch"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","startup_ad_timeout"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","startup_ad_day_max"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","app_bar_guide_width"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","app_bar_guide_height"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","app_bar_guide_url"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","app_bar_guide_time"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","home_tab_event_tag"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","home_tab_event_tag_ext"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","home_tab_player_tag"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","home_tab_player_tag_ext"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","task_center_entrance"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","store_go"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-jq delpaths([["data","function_configs","wall_closed"]])
    - >-
      ^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ response-jq delpaths([["data","float_advertise"]])
    - >-
      ^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ response-jq delpaths([["data","placeholder"]])

